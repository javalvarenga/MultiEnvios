# MultiEnviosGT API - Environment Variables Example
# Copy this file to .env and adjust values.
# .env is gitignored and should never be committed.

# Server port
PORT=8000

# JWT secret used to sign and verify auth tokens
JWT_SECRET=change_this_secret_in_production

# MySQL database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=multienviosgt